<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Control de Gastos de Obra - Uniproyect</title>
    <meta name="description" content="Aplicación profesional para el control, gestión y reconocimiento IA de facturas, albaranes, costes de personal y gastos de construcción de José Real Construcciones, S.L." />
    <meta property="og:title" content="Control de Gastos de Obra - Uniproyect" />
    <meta property="og:description" content="Aplicación profesional para el control, gestión y reconocimiento IA de facturas, albaranes, costes de personal y gastos de construcción de José Real Construcciones, S.L." />
    <meta name="theme-color" content="#1e293b" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%232563eb'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>" />
    <script>
      // Suppress benign Vite HMR WebSocket connection errors in sandbox container
      window.addEventListener('error', function(event) {
        if (event && event.filename && (event.filename.includes('@vite/client') || event.filename.includes('vite'))) {
          event.stopImmediatePropagation();
          event.preventDefault();
          return true;
        }
      }, true);
      window.addEventListener('unhandledrejection', function(event) {
        if (event && event.reason && (String(event.reason).includes('WebSocket') || String(event.reason).includes('vite'))) {
          event.stopImmediatePropagation();
          event.preventDefault();
          return true;
        }
      }, true);
    </script>
  </head>
  <body class="bg-slate-900 text-slate-100 antialiased min-h-screen">
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
